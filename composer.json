{
	"name": "software-by-design/nextcloud-audiocheck",
	"description": "Audio library and player for Nextcloud",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"require": {
		"php": ">=8.2",
		"james-heinrich/getid3": "^1.9"
	},
	"require-dev": {
		"brianhenryie/strauss": "^0.28.0",
		"nextcloud/ocp": "^32.0 || ^33.0 || ^34.0 || ^35.0",
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"OCA\\AudioCheck\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\AudioCheck\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/",
			"NCU\\": "vendor/nextcloud/ocp/NCU/"
		}
	},
	"scripts": {
		"post-autoload-dump": "@php composer/strauss-if-dev.php",
		"test": "phpunit"
	},
	"extra": {
		"strauss": {
			"namespace_prefix": "OCA\\AudioCheck\\Vendor\\",
			"classmap_prefix": "AudioCheck_",
			"constants_prefix": "AudioCheck_",
			"target_directory": "vendor-prefixed"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true
	}
}
